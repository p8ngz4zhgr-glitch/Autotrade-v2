# API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Telegram Bot Configuration
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REGISTER_TOKEN=
TELEGRAM_REPORT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Server & Administration
ADMIN_SECRET=admin123
REDIS_URL=
APP_URL=
RENDER_EXTERNAL_URL=

# ══════════════════════════════════════════════════════════════════
# CẤU HÌNH SCALPING & QUẢN TRỊ VỐN CHỐNG CHÁY / CHỐNG QUÉT RÂU SL
# ══════════════════════════════════════════════════════════════════
M5_SCALP_MODE=true

# --- KỊCH BẢN 1: DÀNH CHO VỐN HIỆN TẠI $116 (Đòn bẩy x5) ---
# Mục tiêu thực tế an toàn bền vững: $10/ngày (~8.6%/ngày = x2 tài khoản sau 1 tháng)
# DAILY_PROFIT_TARGET_USD=10.0
# DAILY_MAX_LOSS_USD=8.0
# MAX_RISK_PER_TRADE_PCT=1.5
# MAX_SAFE_LEVERAGE=5

# --- KỊCH BẢN 2: DÀNH CHO MỤC TIÊU $20 - $50/NGÀY (Khuyên dùng Vốn $300 - $500) ---
DAILY_PROFIT_TARGET_USD=30.0
DAILY_MAX_LOSS_USD=15.0
MAX_RISK_PER_TRADE_PCT=1.0
MAX_SAFE_LEVERAGE=10

# Khóa giao dịch nếu dính 3 lệnh SL liên tiếp (nghỉ 60 phút tránh giật tin tức)
CONSECUTIVE_LOSS_LIMIT=3

# Tự động dời SL về Entry + phí sàn ngay khi đạt TP1 (1.0R - 1.2R) -> 0 ĐỒNG RỦI RO
AUTO_BREAKEVEN_ON_TP1=true
